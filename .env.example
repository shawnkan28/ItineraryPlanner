# Single-user password for the app (required in production)
APP_PASSWORD=change-me
# Secret used to sign the session cookie
SESSION_SECRET=a-long-random-string
# SQLite file
DATABASE_PATH=data/itinerary_planner.db
# Optional: Obsidian vault root (folder containing Travel/ and _attachments/)
VAULT_PATH=
# Docker only: public URL and the host folder of the vault
ORIGIN=http://localhost:3000
VAULT_HOST_PATH=/path/to/PKM
